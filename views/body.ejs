<h1 class="cc">crossex Data Input</h1>
<form>
    <textarea id="myccinput" placeholder="Paste CSV, TSV, or JSON data here — or drag and drop a file" style="width:100%;height:200px;font-size:xx-small;"></textarea>
    <input type="file" id="ccfileinput" accept=".csv,.tsv,.txt,.tab,.json" style="display:none">
    <div style="display:inline-flex">
        <div id="graph_button" class="cc_button active">Graph Data</div>
        <div id="load_file" class="cc_button">Load File</div>
        <div id="default_data" class="cc_button">Load Demo Data</div>
        <div id="large_demo" class="cc_button">Load 5M Demo</div>
        <div id="pivot_button" class="cc_button">Pivot Table</div>
        <div id="threed_button" class="cc_button">3D View</div>
        <div id="clear_cookies" class="cc_button">Clear Settings</div>
    </div>
</form>
<br>
<div class="accd jsa" id="About" style="width: 100%;margin: 0 auto">
  <div id="smartplot_id" ></div>
</div>
<div id="cc_pivot_wrap" style="display:none;margin-top:10px">
  <div id="cc_pivot_note" style="font-size:11px;color:#666;margin-bottom:4px"></div>
  <div id="cc_pivot"></div>
</div>
<div id="cc_3d_wrap" style="display:none;margin-top:10px">
  <div id="cc_3d_controls" class="cc_3d_controls"></div>
  <div id="cc_3d_note" style="font-size:11px;color:#666;margin:4px 0"></div>
  <div id="cc_3d_stage" class="cc_3d_stage"></div>
  <div id="cc_3d_legend" class="cc_3d_legend"></div>
</div>
