<h1 class="cc">crossex <span class="cc_tagline">paste a table · click · explore</span></h1>
<form>
    <textarea id="myccinput" placeholder="Paste CSV, TSV, or JSON data here — or drag and drop a file" style="width:100%;height:90px;font-size:xx-small;"></textarea>
    <input type="file" id="ccfileinput" accept=".csv,.tsv,.txt,.tab,.json" style="display:none">
    <div style="display:inline-flex;flex-wrap:wrap;gap:2px">
        <div id="graph_button" class="cc_button active">Graph Data</div>
        <div id="load_file" class="cc_button">Load File</div>
        <div id="default_data" class="cc_button">Load Demo Data</div>
        <div id="large_demo" class="cc_button">Load 5M Demo</div>
        <div id="pivot_button" class="cc_button">Pivot Table</div>
        <div id="share_link" class="cc_button">Share Link</div>
        <div id="dark_toggle" class="cc_button">Dark Mode</div>
        <div id="clear_cookies" class="cc_button">Clear Settings</div>
    </div>
</form>
<div id="cc_toast"></div>
<div id="cc_gallery">
    <div class="cc_gallery_head"><b>Chart gallery</b> — click an example to open it with the demo dataset,
        or paste your own data above and press <b>Graph Data</b>. Chart types are chosen automatically
        from the columns you map to X, Y, color, and facets.</div>
    <div class="cc_gallery_grid">
        <div class="cc_gcard" data-gallery="scatter">
            <svg viewBox="0 0 120 76"><path d="M14 6 V64 H114" fill="none" stroke="#ccc"/><circle cx="30" cy="52" r="3" fill="#4c78a8"/><circle cx="42" cy="44" r="3" fill="#4c78a8"/><circle cx="49" cy="53" r="3" fill="#4c78a8"/><circle cx="55" cy="38" r="3" fill="#4c78a8"/><circle cx="60" cy="28" r="3" fill="#f58518"/><circle cx="72" cy="24" r="3" fill="#f58518"/><circle cx="84" cy="31" r="3" fill="#f58518"/><circle cx="68" cy="36" r="3" fill="#f58518"/><circle cx="78" cy="14" r="3" fill="#54a24b"/><circle cx="92" cy="17" r="3" fill="#54a24b"/><circle cx="98" cy="24" r="3" fill="#54a24b"/><circle cx="104" cy="12" r="3" fill="#54a24b"/></svg>
            <div class="cc_gname">Scatter</div>
            <div class="cc_gdesc">two numeric columns</div>
        </div>
        <div class="cc_gcard" data-gallery="line">
            <svg viewBox="0 0 120 76"><path d="M14 6 V64 H114" fill="none" stroke="#ccc"/><polyline points="16,54 38,42 62,46 86,26 112,18" fill="none" stroke="#4c78a8" stroke-width="2.5"/><polyline points="16,62 38,57 62,50 86,45 112,38" fill="none" stroke="#f58518" stroke-width="2.5"/></svg>
            <div class="cc_gname">Line / Time Series</div>
            <div class="cc_gdesc">mean line over a numeric X</div>
        </div>
        <div class="cc_gcard" data-gallery="histogram">
            <svg viewBox="0 0 120 76"><path d="M14 6 V64 H114" fill="none" stroke="#ccc"/><rect x="18" y="46" width="11" height="18" fill="#4c78a8"/><rect x="31" y="34" width="11" height="30" fill="#4c78a8"/><rect x="44" y="18" width="11" height="46" fill="#4c78a8"/><rect x="57" y="10" width="11" height="54" fill="#4c78a8"/><rect x="70" y="24" width="11" height="40" fill="#4c78a8"/><rect x="83" y="40" width="11" height="24" fill="#4c78a8"/><rect x="96" y="52" width="11" height="12" fill="#4c78a8"/></svg>
            <div class="cc_gname">Histogram</div>
            <div class="cc_gdesc">one numeric column (Y = None)</div>
        </div>
        <div class="cc_gcard" data-gallery="box">
            <svg viewBox="0 0 120 76"><path d="M14 6 V64 H114" fill="none" stroke="#ccc"/><line x1="40" y1="12" x2="40" y2="58" stroke="#4c78a8"/><rect x="28" y="26" width="24" height="20" fill="#4c78a8" fill-opacity="0.35" stroke="#4c78a8"/><line x1="28" y1="36" x2="52" y2="36" stroke="#4c78a8" stroke-width="2"/><line x1="86" y1="18" x2="86" y2="62" stroke="#f58518"/><rect x="74" y="30" width="24" height="18" fill="#f58518" fill-opacity="0.35" stroke="#f58518"/><line x1="74" y1="40" x2="98" y2="40" stroke="#f58518" stroke-width="2"/></svg>
            <div class="cc_gname">Box Plot</div>
            <div class="cc_gdesc">categorical X + numeric Y</div>
        </div>
        <div class="cc_gcard" data-gallery="violin">
            <svg viewBox="0 0 120 76"><path d="M14 6 V64 H114" fill="none" stroke="#ccc"/><path d="M40 10 C52 24 54 36 40 62 C26 36 28 24 40 10 Z" fill="#4c78a8" fill-opacity="0.45" stroke="#4c78a8"/><path d="M86 16 C96 28 98 40 86 64 C74 40 76 28 86 16 Z" fill="#f58518" fill-opacity="0.45" stroke="#f58518"/></svg>
            <div class="cc_gname">Violin Plot</div>
            <div class="cc_gdesc">distribution by category</div>
        </div>
        <div class="cc_gcard" data-gallery="stacked">
            <svg viewBox="0 0 120 76"><path d="M14 6 V64 H114" fill="none" stroke="#ccc"/><rect x="24" y="40" width="20" height="24" fill="#4c78a8"/><rect x="24" y="26" width="20" height="14" fill="#f58518"/><rect x="24" y="16" width="20" height="10" fill="#54a24b"/><rect x="54" y="34" width="20" height="30" fill="#4c78a8"/><rect x="54" y="20" width="20" height="14" fill="#f58518"/><rect x="54" y="12" width="20" height="8" fill="#54a24b"/><rect x="84" y="46" width="20" height="18" fill="#4c78a8"/><rect x="84" y="34" width="20" height="12" fill="#f58518"/><rect x="84" y="28" width="20" height="6" fill="#54a24b"/></svg>
            <div class="cc_gname">Stacked Bar</div>
            <div class="cc_gdesc">counts split by color</div>
        </div>
        <div class="cc_gcard" data-gallery="heatmap">
            <svg viewBox="0 0 120 76"><g stroke="#fff"><rect x="18" y="10" width="23" height="17" fill="#4c78a8" fill-opacity="0.9"/><rect x="41" y="10" width="23" height="17" fill="#4c78a8" fill-opacity="0.35"/><rect x="64" y="10" width="23" height="17" fill="#4c78a8" fill-opacity="0.6"/><rect x="87" y="10" width="23" height="17" fill="#4c78a8" fill-opacity="0.2"/><rect x="18" y="27" width="23" height="17" fill="#4c78a8" fill-opacity="0.5"/><rect x="41" y="27" width="23" height="17" fill="#4c78a8" fill-opacity="0.85"/><rect x="64" y="27" width="23" height="17" fill="#4c78a8" fill-opacity="0.25"/><rect x="87" y="27" width="23" height="17" fill="#4c78a8" fill-opacity="0.7"/><rect x="18" y="44" width="23" height="17" fill="#4c78a8" fill-opacity="0.3"/><rect x="41" y="44" width="23" height="17" fill="#4c78a8" fill-opacity="0.55"/><rect x="64" y="44" width="23" height="17" fill="#4c78a8" fill-opacity="0.95"/><rect x="87" y="44" width="23" height="17" fill="#4c78a8" fill-opacity="0.4"/></g></svg>
            <div class="cc_gname">Grid / Heatmap</div>
            <div class="cc_gdesc">two categorical columns</div>
        </div>
        <div class="cc_gcard" data-gallery="facet">
            <svg viewBox="0 0 120 76"><rect x="14" y="8" width="45" height="8" fill="#e4e4e4"/><rect x="63" y="8" width="45" height="8" fill="#e4e4e4"/><rect x="14" y="16" width="45" height="48" fill="none" stroke="#bbb"/><rect x="63" y="16" width="45" height="48" fill="none" stroke="#bbb"/><circle cx="24" cy="52" r="2.5" fill="#4c78a8"/><circle cx="33" cy="42" r="2.5" fill="#4c78a8"/><circle cx="42" cy="34" r="2.5" fill="#f58518"/><circle cx="50" cy="26" r="2.5" fill="#f58518"/><circle cx="38" cy="50" r="2.5" fill="#4c78a8"/><circle cx="73" cy="46" r="2.5" fill="#4c78a8"/><circle cx="82" cy="56" r="2.5" fill="#f58518"/><circle cx="90" cy="30" r="2.5" fill="#f58518"/><circle cx="99" cy="24" r="2.5" fill="#54a24b"/><circle cx="86" cy="38" r="2.5" fill="#54a24b"/></svg>
            <div class="cc_gname">Faceted Grid</div>
            <div class="cc_gdesc">subplots by a category</div>
        </div>
        <div class="cc_gcard" data-gallery="corr">
            <svg viewBox="0 0 120 76"><g stroke="#fff"><rect x="28" y="6" width="16" height="16" fill="#830862"/><rect x="45" y="6" width="16" height="16" fill="#4c78a8" fill-opacity="0.55"/><rect x="62" y="6" width="16" height="16" fill="#4c78a8" fill-opacity="0.2"/><rect x="79" y="6" width="16" height="16" fill="#4c78a8" fill-opacity="0.4"/><rect x="28" y="23" width="16" height="16" fill="#4c78a8" fill-opacity="0.55"/><rect x="45" y="23" width="16" height="16" fill="#830862"/><rect x="62" y="23" width="16" height="16" fill="#4c78a8" fill-opacity="0.75"/><rect x="79" y="23" width="16" height="16" fill="#4c78a8" fill-opacity="0.1"/><rect x="28" y="40" width="16" height="16" fill="#4c78a8" fill-opacity="0.2"/><rect x="45" y="40" width="16" height="16" fill="#4c78a8" fill-opacity="0.75"/><rect x="62" y="40" width="16" height="16" fill="#830862"/><rect x="79" y="40" width="16" height="16" fill="#4c78a8" fill-opacity="0.65"/><rect x="28" y="57" width="16" height="16" fill="#4c78a8" fill-opacity="0.4"/><rect x="45" y="57" width="16" height="16" fill="#4c78a8" fill-opacity="0.1"/><rect x="62" y="57" width="16" height="16" fill="#4c78a8" fill-opacity="0.65"/><rect x="79" y="57" width="16" height="16" fill="#830862"/></g></svg>
            <div class="cc_gname">Correlation Matrix</div>
            <div class="cc_gdesc">every column pair, click to open</div>
        </div>
        <div class="cc_gcard" data-gallery="threed">
            <svg viewBox="0 0 120 76"><path d="M35 24 L60 12 L85 24 L85 52 L60 64 L35 52 Z" fill="none" stroke="#999"/><path d="M35 24 L60 36 L85 24 M60 36 L60 64" fill="none" stroke="#999"/><circle cx="52" cy="30" r="2.5" fill="#4c78a8"/><circle cx="66" cy="26" r="2.5" fill="#f58518"/><circle cx="58" cy="46" r="2.5" fill="#54a24b"/><circle cx="70" cy="44" r="2.5" fill="#4c78a8"/><circle cx="48" cy="42" r="2.5" fill="#e45756"/><circle cx="64" cy="54" r="2.5" fill="#f58518"/><circle cx="74" cy="34" r="2.5" fill="#54a24b"/><circle cx="55" cy="57" r="2.5" fill="#4c78a8"/></svg>
            <div class="cc_gname">3D Unit View</div>
            <div class="cc_gdesc">every row as a WebGL point</div>
        </div>
        <div class="cc_gcard" data-gallery="overview">
            <svg viewBox="0 0 120 76"><rect x="14" y="12" width="28" height="52" rx="3" fill="none" stroke="#bbb"/><rect x="17" y="40" width="5" height="20" fill="#4c78a8"/><rect x="23" y="30" width="5" height="30" fill="#4c78a8"/><rect x="29" y="22" width="5" height="38" fill="#4c78a8"/><rect x="35" y="34" width="5" height="26" fill="#4c78a8"/><rect x="46" y="12" width="28" height="52" rx="3" fill="none" stroke="#bbb"/><rect x="49" y="26" width="5" height="34" fill="#f58518"/><rect x="55" y="36" width="5" height="24" fill="#f58518"/><rect x="61" y="20" width="5" height="40" fill="#f58518"/><rect x="67" y="44" width="5" height="16" fill="#f58518"/><rect x="78" y="12" width="28" height="52" rx="3" fill="none" stroke="#bbb"/><rect x="81" y="32" width="5" height="28" fill="#54a24b"/><rect x="87" y="24" width="5" height="36" fill="#54a24b"/><rect x="93" y="42" width="5" height="18" fill="#54a24b"/><rect x="99" y="30" width="5" height="30" fill="#54a24b"/></svg>
            <div class="cc_gname">Column Overview</div>
            <div class="cc_gdesc">a distribution card per column</div>
        </div>
    </div>
</div>
<br>
<div class="accd jsa" id="About" style="width: 100%;margin: 0 auto">
  <div id="smartplot_id" ></div>
</div>
<div id="cc_pivot_wrap" style="display:none;margin-top:10px">
  <div id="cc_pivot_note" style="font-size:11px;color:#666;margin-bottom:4px"></div>
  <div id="cc_pivot"></div>
</div>
